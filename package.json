{
  "name": "getmosaic",
  "version": "0.1.40",
  "description": "Less noise, more signal — market intelligence for your team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mosaic": "./bin/mosaic.sh"
  },
  "files": [
    "dist/bundle.js",
    "dist/index.js",
    "dist/index.d.ts",
    "bin",
    "install.sh",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node_modules/.bin/esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/bundle.js --external:openclaw",
    "dev": "tsc --watch",
    "prepare": "tsc && node_modules/.bin/esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/bundle.js --external:openclaw"
  },
  "openclaw": {
    "extensions": [
      "./dist/bundle.js"
    ]
  },
  "keywords": [
    "openclaw",
    "plugin",
    "market-intelligence",
    "hyperspell",
    "ai-agent"
  ],
  "dependencies": {
    "@hyperspell/hyperspell": "^0.38.0",
    "@sinclair/typebox": "^0.34.0",
    "openclaw": "^2026.5.7"
  },
  "peerDependencies": {
    "openclaw": "^2026.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  }
}
